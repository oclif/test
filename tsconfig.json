{
  "compilerOptions": {
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "module": "commonjs",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "./lib",
    "pretty": true,
    "rootDir": "./src",
    "strict": true,
    "target": "es2022",
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["./src/**/*"]
}
